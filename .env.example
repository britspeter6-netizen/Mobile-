# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=PassiveEngine
ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (zero config, fine for <10k subscribers):
DATABASE_URL=sqlite:///./passive_engine.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:pass@localhost:5432/passive_engine

# ── AI Providers ─────────────────────────────────────────────────────────────
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Get from platform.openai.com (fallback only — Claude is primary)
OPENAI_API_KEY=sk-...
AI_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=gpt-4o-mini

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create 3 recurring prices in Stripe dashboard, paste IDs:
STRIPE_PRICE_STARTER=price_...    # $29/month
STRIPE_PRICE_PRO=price_...        # $79/month
STRIPE_PRICE_AGENCY=price_...     # $199/month

# ── Gumroad ───────────────────────────────────────────────────────────────────
# Get from app.gumroad.com → Settings → Advanced
GUMROAD_ACCESS_TOKEN=...
GUMROAD_SELLER_ID=...

# ── Email (Resend — free tier: 3,000 emails/month) ────────────────────────────
# Get from resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
FROM_EMAIL=hello@yourdomain.com
FROM_NAME=PassiveEngine

# ── WordPress Auto-Publisher ──────────────────────────────────────────────────
# Create Application Password in WordPress → Users → Profile
WP_URL=https://yourblog.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Affiliate ─────────────────────────────────────────────────────────────────
# Apply at affiliate-program.amazon.com
AMAZON_ASSOCIATE_TAG=yourtag-20
CLICKBANK_AFFILIATE_ID=yourclickbankid

# ── Revenue target ────────────────────────────────────────────────────────────
REVENUE_TARGET_MONTHLY=18000
